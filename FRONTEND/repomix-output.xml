                                              ),
                                              TextButton(
                                                onPressed: () {
                                                  Navigator.pop(context);
                                                  final idProducto = productosFiltrados[index]['id'] ?? productosFiltrados[index]['_id'];                                                  _eliminarProducto(idProducto.toString()); // 👈 Asegúrate de pasar el ID real
