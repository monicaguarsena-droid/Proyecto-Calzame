                                color: ColoresApp.primary,
                                fontSize: 11,
                                fontWeight: FontWeight.bold,
                              ),
                            ),
                          ),
                          const Text(
                            ' y ',
                            style: TextStyle(
                              color: ColoresApp.textSecondary,
                              fontSize: 11,
                            ),
                          ),
                          GestureDetector(
                            onTap: widget.onPolitica,
                            child: const Text(
                              'Política de privacidad',
                              style: TextStyle(
                                color: ColoresApp.primary,
                                fontSize: 11,
